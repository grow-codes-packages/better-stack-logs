# Service-owned (not generated by sdk-kit): live checks against the real Better Stack Logs
# service (GRO-1385). Run from the repository root with `make -C live live` (or `make live` here).
#
#   BETTERSTACK_INGEST_HOST=... BETTERSTACK_SOURCE_TOKEN=... BETTERSTACK_QUERY_HOST=... \
#   BETTERSTACK_QUERY_USER=... BETTERSTACK_QUERY_PASSWORD=... BETTERSTACK_SOURCE_TABLE=... \
#   make -C live live
#
# Without them the suite prints "skipped: no credentials" and exits 0. The package is installed
# from ./python into live/.venv (PYTHON picks the interpreter, default python3).

SHELL := /bin/sh
PYTHON ?= python3
VENV ?= .venv

.PHONY: live lint format clean

live:
	@PYTHON="$(PYTHON)" LIVE_VENV="$(VENV)" sh ./run.sh

$(VENV)/bin/ruff:
	$(PYTHON) -m venv $(VENV)
	$(VENV)/bin/python -m pip install --quiet "ruff>=0.8"

lint: $(VENV)/bin/ruff
	$(VENV)/bin/ruff check .
	$(VENV)/bin/ruff format --check .

format: $(VENV)/bin/ruff
	$(VENV)/bin/ruff format .
	$(VENV)/bin/ruff check --fix .

clean:
	rm -rf $(VENV) .ruff_cache __pycache__
